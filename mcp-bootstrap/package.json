{
  "name": "@newwe/huahua",
  "version": "0.4.0",
  "description": "Local LAN MCP adapter for a HuAHua device agent",
  "type": "module",
  "bin": {
    "huahua": "dist/cli.js",
    "huahua-mcp": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
